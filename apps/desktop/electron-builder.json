{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "org.pulpitai.desktop",
  "productName": "Pulpit AI",
  "copyright": "Copyright © 2026 Pulpit AI Open Source Contributors",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/@pulpit-ai/speech-engine/bin/**/*",
    "**/node_modules/@pulpit-ai/speech-engine/models/**/*"
  ],
  "extraResources": [
    {
      "from": "../../packages/scripture-engine/data",
      "to": "data",
      "filter": ["*.json"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Pulpit AI"
  }
}
