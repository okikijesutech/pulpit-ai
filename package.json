{
  "name": "pulpit-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, local-first church presentation assistant for FreeShow",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "start": "pnpm --filter @pulpit-ai/desktop start",
    "dev": "pnpm --filter @pulpit-ai/desktop dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "echo \"Linting workspace...\""
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
