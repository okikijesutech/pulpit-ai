{
  "name": "pulpit-ai",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Open-source, local-first church presentation assistant for FreeShow",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "start": "pnpm --filter @pulpit-ai/desktop start",
    "dev": "pnpm --filter @pulpit-ai/desktop dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate": "node --experimental-strip-types scripts/evaluate_pipeline.ts",
    "benchmark": "node --experimental-strip-types scripts/benchmark_performance.ts",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:strict": "node --experimental-strip-types scripts/strict_typecheck.ts",
    "lint": "eslint apps/desktop/src packages scripts",
    "check:pr": "pnpm run build && pnpm run typecheck:strict && pnpm run lint && pnpm test && pnpm run evaluate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.8"
  }
}
